{
  "manifest_version": 3,
  "name": "Zenoti Session Inspector",
  "version": "1.0.0",
  "description": "Inspect and monitor your Zenoti session token on CorePower Yoga.",
  "permissions": [
    "storage",
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "https://corepoweryoga.zenoti.com/*",
    "https://*.zenoti.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://corepoweryoga.zenoti.com/*", "https://*.zenoti.com/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "icons/*.png"],
      "matches": ["https://corepoweryoga.zenoti.com/*", "https://*.zenoti.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
